<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Run once at login, then hourly while the Mac is awake.
     Captions first, local audio transcription second; durable upload retries. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.streetsignal.transcripts</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/inayat/Projects/thestreetsignal/scripts/local/transcript-runner.mjs</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>StandardOutPath</key>
  <string>/tmp/streetsignal-transcripts.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/streetsignal-transcripts.log</string>
</dict>
</plist>
