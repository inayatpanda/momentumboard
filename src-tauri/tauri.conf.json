{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "StreetSignal",
  "version": "../package.json",
  "identifier": "uk.co.rqai.thestreetsignal",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StreetSignal",
        "width": 1440,
        "height": 900,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri:; connect-src 'self' https://thestreetsignal.rqai.co.uk; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg"
    ],
    "category": "Finance",
    "shortDescription": "Watchlist, setups and alerts for swing trading.",
    "longDescription": "StreetSignal \u2014 watchlist, setups and alerts for swing trading. Informs; does not predict.",
    "copyright": "\u00a9 RQAI",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true,
      "signingIdentity": "Developer ID Application: Inayat Panda (G3RVS73AU3)"
    }
  }
}
