FINNHUB_API_KEY=your-finnhub-key
APP_TOKEN=long-random-secret
# optional — congressional trading (Intel screen) upgrades to live QuiverQuant data automatically when set
QUIVER_API_KEY=
# optional — free-tier Financial Modeling Prep key; second rung of the congressional-trading source ladder
FMP_API_KEY=
# optional — Supadata YouTube-transcript API (free tier 100/mo, get a key at supadata.ai).
# The cheap middle rung of the video-extract ladder: free caption scrape → SUPADATA → Gemini watches the video.
# Datacenter IPs block the free scrape, so without this key every video falls to the (rate-capped) Gemini rung.
SUPADATA_API_KEY=
# --- LLM providers (the paper's journalist + news triage). At least one key
# activates the LLM; router priority is Groq → Gemini → OpenAI → Anthropic.
GROQ_API_KEY=
GEMINI_API_KEY=
# optional model overrides — change these (no code deploy) if a provider
# retires/renames a model. Defaults track the current pins in lib/llm.ts.
#   GROQ_MODEL   default llama-3.3-70b-versatile  (successor e.g. meta-llama/llama-4-scout-17b-16e-instruct)
#   GEMINI_MODEL default gemini-2.5-flash
GROQ_MODEL=
GEMINI_MODEL=
# --- Scoped tokens (audit H-1) ---
# REPORT_TOKEN historically guarded THREE things at once: the Telegram webhook,
# the report publisher, and the private Helm export. The code now prefers these
# dedicated secrets and only falls back to REPORT_TOKEN when they are unset, so
# you can cut over one boundary at a time with zero downtime:
#   TELEGRAM_WEBHOOK_SECRET — set it, then re-register the webhook:
#       curl "https://api.telegram.org/bot<BOT_TOKEN>/setWebhook?url=<webhook-url>&secret_token=<new-secret>"
#   REPORT_PUBLISH_TOKEN    — set it on Netlify AND in the daily-paper/queue-worker GitHub secrets (the composer sends it).
#   HELM_EXPORT_TOKEN       — set it, then update the Helm app to send it as x-report-token.
# Once all three are set everywhere and verified, remove REPORT_TOKEN.
TELEGRAM_WEBHOOK_SECRET=
REPORT_PUBLISH_TOKEN=
HELM_EXPORT_TOKEN=
