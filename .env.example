FINNHUB_API_KEY=your-finnhub-key
APP_TOKEN=long-random-secret
# optional — congressional trading (Intel screen) upgrades to live QuiverQuant data automatically when set
QUIVER_API_KEY=
# optional — free-tier Financial Modeling Prep key; second rung of the congressional-trading source ladder
FMP_API_KEY=
# --- LLM providers (the paper's journalist + news triage). At least one key
# activates the LLM; router priority is Groq → Gemini → OpenAI → Anthropic.
GROQ_API_KEY=
GEMINI_API_KEY=
# optional model overrides — change these (no code deploy) if a provider
# retires/renames a model. Defaults track the current pins in lib/llm.ts.
#   GROQ_MODEL   default llama-3.3-70b-versatile  (successor e.g. meta-llama/llama-4-scout-17b-16e-instruct)
#   GEMINI_MODEL default gemini-2.5-flash
GROQ_MODEL=
GEMINI_MODEL=
